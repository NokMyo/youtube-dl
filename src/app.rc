#pragma code_page(65001)

#include <windows.h>
#include "resource.h"
#include "version.h"

1 RT_MANIFEST "app.manifest"
IDI_APP_ICON ICON "app.ico"
IDI_FEBIUS_SYMBOL ICON "febius-symbol.ico"

IDD_ABOUT DIALOGEX 0, 0, 560, 340
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Downrush 정보"
FONT 9, "Segoe UI"
BEGIN
    CONTROL         "", IDC_ABOUT_BANNER, "STATIC", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 0, 0, 560, 340
    CONTROL         "업데이트 확인", IDC_ABOUT_UPDATE, "BUTTON", BS_OWNERDRAW | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 366, 145, 170, 34
    CONTROL         "릴리스 페이지", IDC_ABOUT_RELEASES, "BUTTON", BS_OWNERDRAW | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 366, 187, 170, 34
    CONTROL         "라이선스", IDC_ABOUT_LICENSE, "BUTTON", BS_OWNERDRAW | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 366, 229, 170, 34
    CONTROL         "시스템 정보", IDC_ABOUT_SYSTEM, "BUTTON", BS_OWNERDRAW | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 366, 271, 170, 34
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION APP_VERSION_COMMA
 PRODUCTVERSION APP_VERSION_COMMA
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041204B0"
        BEGIN
            VALUE "CompanyName", "Febius\0"
            VALUE "FileDescription", "Febius Downrush\0"
            VALUE "FileVersion", APP_VERSION_TEXT "\0"
            VALUE "InternalName", "FebiusDownrush\0"
            VALUE "LegalCopyright", APP_COPYRIGHT_TEXT "\0"
            VALUE "OriginalFilename", "FebiusDownrush.exe\0"
            VALUE "ProductName", "Febius Downrush\0"
            VALUE "ProductVersion", APP_VERSION_TEXT "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0412, 1200
    END
END
