BEGIN
    CONTROL         "", IDC_ABOUT_BANNER, "STATIC", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 0, 0, 390, 63
    GROUPBOX        "제품 정보", -1, 12, 72, 366, 64
